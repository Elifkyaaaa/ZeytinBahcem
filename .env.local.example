# =============================================================================
#  Elmora Zeytincilik — ortam değişkenleri
#  Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
#
#  ÖNEMLİ: Proje bu anahtarların hiçbiri tanımlı olmadan da eksiksiz çalışır.
#  Katalog `src/lib/data` altındaki tipli sabitlerden okunur; ödeme ve mail
#  adımları demo modunda yürür. Bir anahtar grubu tanımlandığı anda ilgili
#  katman otomatik olarak gerçek servise geçer.
# =============================================================================

# -----------------------------------------------------------------------------
#  Site
# -----------------------------------------------------------------------------
# OAuth dönüş adresleri ve e-posta bağlantıları bu adrese göre üretilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
#  Supabase — veritabanı ve kimlik doğrulama
#  Panel: https://supabase.com/dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servis rolü RLS'i atlar — YALNIZCA sunucuda kullanılır, asla istemciye sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
#  Cloudinary — ürün ve blog görselleri
#  Panel: https://console.cloudinary.com → Dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=elmora

# -----------------------------------------------------------------------------
#  iyzico — ödeme
#  Sandbox: https://sandbox-merchant.iyzipay.com
#  Canlı:   https://merchant.iyzipay.com
# -----------------------------------------------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test için sandbox, canlıda https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# -----------------------------------------------------------------------------
#  Resend — işlemsel e-postalar (sipariş onayı, kargo bildirimi)
#  Panel: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Gönderen adresi doğrulanmış bir alan adına ait olmalıdır.
RESEND_FROM="Elmora Zeytincilik <siparis@elmora.com>"
# Yeni siparişlerin bildirileceği adres (boş bırakılabilir).
ADMIN_NOTIFY_EMAIL=

# -----------------------------------------------------------------------------
#  Güvenlik
# -----------------------------------------------------------------------------
# Katalog tohumlama ucu (/api/admin/seed) katalogu ezer ve yorumları siler.
# Üretimde varsayılan olarak KAPALIDIR. Yalnızca ilk kurulum sırasında
# geçici olarak açın, işlem bitince bu satırı kaldırın.
# ALLOW_SEED_ENDPOINT=true
